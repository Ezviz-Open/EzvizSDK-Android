<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="300dp"
    android:background="@color/common_bg">

    <!-- 对讲效果 -->
    <com.videogo.widget.RingView
        android:id="@+id/talkback_rv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/transparent"
        android:visibility="gone" />

    <!-- 右上角关闭 -->
    <ImageButton
        android:id="@+id/talkback_close_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:background="@drawable/play_close_selector"
        android:onClick="onClick" />

    <Button
        android:id="@+id/talkback_control_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="@drawable/play_talkback_selector"
        android:text="@string/press_to_talk_release_to_listen"
        android:textColor="@color/white"
        android:textSize="@dimen/realplay_button_text_size" />

    <!-- 变声 -->
    <LinearLayout
        android:id="@+id/talk_voice_change_ll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp"
        android:orientation="vertical">

        <Button
            android:id="@+id/talk_voice_normal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="原声" />

        <Button
            android:id="@+id/talk_voice_clown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="小丑音" />

        <Button
            android:id="@+id/talk_voice_man"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="大叔音" />

    </LinearLayout>

    <TextView
        android:id="@+id/talkback_local_loudness_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="23dp"
        android:layout_toRightOf="@+id/talk_voice_change_ll"
        android:text="本地音频音量：-40分贝" />

    <Switch
        android:id="@+id/switch_remote_mute"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignLeft="@id/talkback_local_loudness_tv"
        android:layout_marginTop="70dp"
        android:switchPadding="5dp"
        android:text="对讲时设备端静音"
        android:textColor="@color/grey" />

</RelativeLayout>