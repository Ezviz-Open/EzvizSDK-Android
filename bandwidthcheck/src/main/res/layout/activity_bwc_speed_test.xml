<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8F7"
    android:orientation="vertical"
    tools:context="com.ezviz.bandwidthcheck.BWCSpeedTestInputActivity">

    <com.ezviz.common.TitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- 测速UI -->
    <RelativeLayout
        android:id="@+id/rl_speed_testing"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <LinearLayout
            android:id="@+id/ll_device"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="26dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="设备："
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_device"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AB1234567@1"
                android:textColor="@color/black"
                android:textSize="14sp" />
        </LinearLayout>

        <RelativeLayout
            android:id="@+id/rl_speed_testing_anim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/ll_device"
            android:layout_marginTop="40dp">

            <pl.droidsonroids.gif.GifImageView
                android:id="@+id/gif_speed_testing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:src="@mipmap/gif_speed_testing" />

            <TextView
                android:id="@+id/tv_speed_testing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="10dp"
                android:text="测速中"
                android:textColor="@color/white"
                android:textSize="32sp" />

        </RelativeLayout>

        <Button
            android:id="@+id/btn_stop"
            android:layout_width="150dp"
            android:layout_height="48dp"
            android:layout_below="@id/rl_speed_testing_anim"
            android:layout_centerHorizontal="true"
            android:background="@drawable/selector_red_8dp"
            android:text="停止测速"
            android:textColor="@color/white"
            android:textSize="16sp" />

    </RelativeLayout>

    <!-- 测速失败UI -->
    <LinearLayout
        android:id="@+id/ll_speed_test_fail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="200dp"
            android:src="@mipmap/iv_bwc_fail" />

        <TextView
            android:id="@+id/tv_speed_test_fail_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:text="检测失败"
            android:textColor="#666666"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_speed_test_fail_reason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginLeft="60dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="60dp"
            android:gravity="center"
            android:text=""
            android:textColor="#999999"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_retry"
            android:layout_width="150dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:background="@drawable/selector_blue_8dp"
            android:text="重新测速"
            android:textColor="@color/white"
            android:textSize="16sp" />

    </LinearLayout>

</LinearLayout>